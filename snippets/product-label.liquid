<style>
  .product-card-wrapper {
    position: relative;
  }
  
  .product-labels {
    position: absolute;
    bottom: 70px !important;
    left: 115px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center !important;
    gap: 5px;
    width: 100%;
  }
  .product-label {
    padding: 0px 5px;
    text-transform: uppercase;
    text-align: center;
    font-weight: 500;
    font-size: 10px;
    width: fit-content;
    border-radius: 15px;
  }
  .wearehorsemen .product-labels {
   bottom: 70px !important;
    left: 0;
}
    .all .product-labels {
   bottom: 70px !important;
    left: 0;
}
      .panjabi .product-labels {
   bottom: 70px !important;
    left: 0;
}
        .thobe .product-labels {
   bottom: 70px !important;
    left: 0;
}
   .shopify-section.section .product-labels {
    bottom: 70px !important;
    left: 0 ;
}
  
  @media screen and (max-width: 749px) {
  #shopify-section-{{section.id}} .wearehorsemen .product-labels {
   bottom: 70px !important;
    left: 0;
}
 .shopify-section.section .product-labels {
    bottom: 70px !important;
    left: 0 ;
}
  }
</style>

{%- assign labels = product.metafields.custom.labels.value -%}

<div class="product-labels">
  {%- for label in labels -%}
    
    {%- assign background_color = label.color -%}
    {%- assign color_string = "" | append: background_color -%}
    {%- assign text_color = color_string | color_lighten: 100 -%}  
    
    <small class="product-label" style="background-color: {{ background_color }}; color: #000;">
      {{ label.title }}
    </small>
    
  {%- endfor -%}
</div>