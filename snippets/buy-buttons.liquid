  margin-top: 10px;

}
  .price--large {
        font-size: 20px !important;
       font-weight: 500 !important;
      }
  #shopify-section-{{section.id}} .product-popup-modal__content-info p img{
  width: 100%;
}
    .quick-add-modal__content {
  top: 0;
  bottom:0 !important;
  width: 100% !important;
  border-radius: 8px 8px 8px 8px;
}
 #shopify-section-{{section.id}} .product-form__submit {
     background: #B69D74 !important;
     color: #fff !important;
  }
  .button:not([disabled]):hover::after, .shopify-challengebutton:hover::after, .customer button:hover::after, .shopify-payment-buttonbutton--unbranded:hover::after {
