<script>
let videoList = [
    "{{ block.settings.video_url_1 }}",
    "{{ block.settings.video_url_2 }}",
    "{{ block.settings.video_url_3 }}",
    "{{ block.settings.video_url_4 }}"
];
let currentVideoIndex = 0;

// Format time as mm:ss
function formatTime(seconds) {
    let min = Math.floor(seconds / 60);
    let sec = Math.floor(seconds % 60);
    return `${min}:${sec < 10 ? '0' + sec : sec}`;
}

function playVideo(videoUrl) {
    const overlay = document.getElementById("video-overlay");
    const video = document.getElementById("playing-video");
    const source = document.getElementById("video-source");
    const progressBar = document.getElementById("video-progress");
    const currentTimeEl = document.getElementById("current-time");
    const totalDurationEl = document.getElementById("total-duration");

    source.src = videoUrl;
    video.load();
    video.play();
    overlay.style.display = "flex";
    currentVideoIndex = videoList.indexOf(videoUrl);

    updatePlayPauseButton();

    // Reset progress bar and time
    if (progressBar) progressBar.style.width = "0%";
    if (currentTimeEl) currentTimeEl.innerText = "0:00";
    if (totalDurationEl) totalDurationEl.innerText = "0:00";

    // Update total duration when metadata is loaded
    video.onloadedmetadata = function () {
        if (totalDurationEl) totalDurationEl.innerText = formatTime(video.duration);
    };

    // Update progress and current time during playback
    video.ontimeupdate = function () {
        if (video.duration) {
            if (progressBar) {
                const percent = (video.currentTime / video.duration) * 100;
                progressBar.style.width = percent + "%";
            }
            if (currentTimeEl) currentTimeEl.innerText = formatTime(video.currentTime);
        }
    };
}

function closeVideo() {
    const overlay = document.getElementById("video-overlay");
    const video = document.getElementById("playing-video");
    video.pause();
    overlay.style.display = "none";
}

function prevVideo() {
    currentVideoIndex = (currentVideoIndex > 0) ? currentVideoIndex - 1 : videoList.length - 1;
    playVideo(videoList[currentVideoIndex]);
}

function nextVideo() {
    currentVideoIndex = (currentVideoIndex < videoList.length - 1) ? currentVideoIndex + 1 : 0;
    playVideo(videoList[currentVideoIndex]);
}

function toggleMute() {
  const video = document.getElementById("playing-video");
  const muteToggle = document.querySelector(".mute-toggle");
  video.muted = !video.muted;

