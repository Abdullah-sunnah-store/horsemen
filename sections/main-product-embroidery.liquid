function togglePlayPause() {
    const video = document.getElementById("playing-video");
    video.paused ? video.play() : video.pause();
    updatePlayPauseButton();
}

function updatePlayPauseButton() {
    const video = document.getElementById("playing-video");
    const playPauseButton = document.querySelector(".play-pause-toggle");
    if (playPauseButton) {
        playPauseButton.innerText = video.paused ? "▶" : "⏸";
    }
}

document.addEventListener("DOMContentLoaded", function() {
    const videoItems = document.querySelectorAll(".video-item");
    videoItems.forEach(function(item) {
        item.addEventListener("click", function() {
            const videoUrl = this.getAttribute("data-video-url");
            if (videoUrl) {
                playVideo(videoUrl);
            }
        });
    });

    const video = document.getElementById("playing-video");

    // Toggle play/pause on video click
    video.addEventListener("click", function() {
        togglePlayPause();
    });
});

// Keyboard navigation
document.addEventListener("keydown", function(event) {
    if (event.key === "ArrowLeft") {
        prevVideo();
    } else if (event.key === "ArrowRight") {
        nextVideo();
    } else if (event.key === "Escape") {
        closeVideo();
    } else if (event.key === " ") {
        event.preventDefault();
        togglePlayPause();
    }
});

  let swiperInstance = null;

// Initialize Swiper on mobile with navigation
function initSwiperIfMobile() {
  if (window.innerWidth <= 768) {
    if (!swiperInstance) {
      swiperInstance = new Swiper('.mobile-swiper', {
        slidesPerView: 1.2,
        spaceBetween: 16,
        loop: false,
        navigation: {
          nextEl: '.custom-next',
          prevEl: '.custom-prev',
        },
      });
    }
  } else {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  }
}

// Call on load and resize
document.addEventListener("DOMContentLoaded", initSwiperIfMobile);
window.addEventListener("resize", initSwiperIfMobile);

// Existing video click logic (remains the same)
document.addEventListener("DOMContentLoaded", function() {
  const videoItems = document.querySelectorAll(".video-item");
  videoItems.forEach(function(item) {
    item.addEventListener("click", function() {
      const videoUrl = this.getAttribute("data-video-url");
      if (videoUrl) {
        playVideo(videoUrl);
      }
    });
  });
});
