<style>
  .product-social-share {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 15px 0;
}

.product-social-share strong {
  font-size: 18px;
  color: #333;
}

.product-social-share a img {
  width: 18px;
  height: 18px;
  object-fit: contain;
  transition: transform 0.3s;
  margin-top: 10px;

}

/* .product-social-share a:hover img {
  transform: scale(1.1);
} */
  .product__info-container.product__column-sticky svg {
    margin: 0 !important;
}
   #shopify-section-{{section.id}} .product__column-sticky .form__label{
        font-size: 16px;
        font-weight: 500;
  }
  modal-opener.product-popup-modal__opener.quick-add-hidden {
    margin: 0;
}
   @media screen and (max-width: 769px) {
    .product-popup-modal__content-info table{
    height: 219.563px !important;
  }
     .product-popup-modal__content-info {
    padding-right: 4.4rem;
    gap: 32px;
    display: flex;
    flex-direction: column;
}
 }
.gift-msg {
    font-size: 20px;
    font-weight: bold;
    color: #333;
    display: flex;
    align-items: center;
    gap: 8px;
}
  .gift-icon {
    font-size: 22px;
}
    .gift-icon img {
    height: 35px;
    width: 35px;
}
#shopify-section-{{section.id}} .product__media-wrapper .product__column-sticky{
     display: flex;
  width: 100%;
  flex-direction: row-reverse;
  gap: 20px;
  }
 #shopify-section-{{section.id}} .thumbnail-slider.slider-mobile-gutter.quick-add-hidden{
     width: 110px;
  }
  @media screen and  (min-width: 769px) and (max-width: 989px) {
.thumbnail-list.list-unstyled.slider.slider--mobile{
      display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
}
  }
  @media screen and  (max-width: 749px){
    #shopify-section-{{section.id}} .product__media-wrapper .product__column-sticky{
     flex-direction: column;
       gap: 0;
    }
     #shopify-section-{{section.id}} .thumbnail-slider.slider-mobile-gutter.quick-add-hidden{
     width: 100%;
  }
    .thumbnail-list.list-unstyled.slider.slider--mobile{
          margin-left: 10px;
}
  }


#shopify-section-{{section.id}}  .icon-with-text--horizontal .icon-with-text__item {
  flex-direction: column;
  max-width: 115px;
}
 #shopify-section-{{section.id}} .icon-with-text--horizontal {
    display: flex;
    justify-content: space-between !important;
  }

     #shopify-section-{{section.id}}  .shipping-return {
    background: #f8f8f8;
    padding: 12px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    font-family: Arial, sans-serif;
}

 #shopify-section-{{section.id}} .info-item {
    gap: 10px;
    font-size: 14px;
    color: #333;
    display: flex;
    justify-content: center;
}

 #shopify-section-{{section.id}} .info-item img {
    width: 24px;
    height: 24px;
}


  #shopify-section-{{section.id}}  .payment-image-icon img{
      object-fit: contain;
      width: 100%;
}

  
.video-with-text {
  padding: 20px 0;
  margin-top: 1.5rem !important;
}
.video-list {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: nowrap;
}
.video-item {
  text-align: center;
}
  .video-item a {
    text-decoration: none;
    color: #000;
}
.video-thumbnail {
  position: relative;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 5px;
  border: 1px solid #6b5a5a;
}
.video-thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
.play-button {
  position: absolute;
  font-size: 24px;
  color: white;
  border-radius: 50%;
  padding: 10px;
}



  .video-lightbox {
   display: none;
   position: fixed;
   z-index: 99;
   left: 0;
   top: 0;
   width: 100%;
   height: 100%;
   background: rgba(0, 0, 0, 0.9);
   display: flex;
   justify-content: center;
   align-items: center;
}

.video-lightbox-content {
   width: 100%;
   height: 100%;
   position: relative;
}

.video-lightbox-close {
   position: absolute;
   top: 20px;
   right: 30px;
   font-size: 30px;
   color: white;
   cursor: pointer;
   z-index: 100;
}

#videoLightboxFrame {
   width: 100%;
   height: 100%;
   border: none;
}
  .video-list {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .video-item {
    cursor: pointer;
    position: relative;
  }
  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 24px;
    color: white;
    padding: 10px;
    border-radius: 50%;
  }
  .video-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    display:none;
  }
  .video-container {
    position: relative;
    width: 100%;
    max-width: 400px;
  }
  video {
    width: inherit;
    border-radius: 10px;
  }
  .close, .prev, .next, .mute-toggle {
    position: fixed;
    color: white;
    font-size: 20px;
    cursor: pointer;
    background: rgba(0, 0, 0, 0.5);
    padding: 0 12px;
    border-radius: 50%;
  }

.vedio_centerization{
      position: absolute;
        width: 500px;
    left: 50%;
    right: 50%;
    transform: translate(-50%, -50%);
      height: 95%;
      object-fit: cover;
}


.vedio_placement{
          width: 80%;
    border-radius: 10px;
    position: relative;
    left: 50%;
}
.video-progress-container {
  position: absolute;
  top: 24px;
  left: 0;
  right: 0;
  height: 7px;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 10px 10px 0 0;
  overflow: hidden;
  z-index: 20;
  max-width: 500px;
  margin: 0 auto;
}

.video-progress {
  height: 100%;
  width: 0%;
  background-color: #FFF;
  border-radius: 4px;
  transition: width 0.2s linear;
  display: block !important;
}

  .video-time-display {
  position: absolute;
  top: 20px; /* Or bottom if you prefer */
  right: 15px;
  color: #fff;
  font-size: 14px;
  background: rgba(0, 0, 0, 0.5);
  padding: 3px 8px;
  border-radius: 4px;
  z-index: 21;
  font-family: Arial, sans-serif;
}
    .video-thumbnail video {
    width: inherit;
    border-radius: 50%;
    object-fit: cover;
    height: 90px;
}

  .close { top: 15px; transform: translate(390px, 0px);  background: unset; font-size: 40px;}
  .prev { top: 50%; transform: translate(-40px, 0%); }
  .next {  top: 50%;     transform: translate(397px, 0px); }
  .mute-toggle {  top: 83px; transform: translate(397px, 0px); padding: unset; background: none;}

    @media screen and (min-width: 769px) and (max-width: 1020px) {
      .vedio_centerization {
      object-fit: cover;
    }
      .video-progress-container {
 
  top: 21px;

}
    }

  @media screen and (max-width: 768px) {
   .close { top: -5px; right: 10px; background: unset; font-size: 40px; transform: unset;}
  .prev { left: 10px; top: 50%; transform: translateY(-50%); }
  .next { right: 10px; top: 50%; transform: translateY(-50%); }
  .mute-toggle {top: 68px; right: 15px; padding: unset; transform: unset; }

    .vedio_centerization {
      width: 100%;
      object-fit: cover;
      height: 100%;
    }
    .video-progress-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 5px;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 0;
  overflow: hidden;
  z-index: 20;
  max-width: unset;
  margin: 0 auto;
}
    .video-thumbnail {
  position: relative;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 5px;
  border: 1px solid #6b5a5a;
}
  .video-list p {
    margin: 10px 0 0 0;
}
            .video-thumbnail video {
    width: inherit;
    border-radius: 50%;
    object-fit: cover;
    height: 60px;
}
  }
</style>



<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">

       <div class="vedio_placement">
        <div id="video-overlay" class="video-overlay">
          
                 <!-- Progress bar container -->
        <div class="video-progress-container">
            <div class="video-progress" id="video-progress"></div>
            </div>
        
      
          <div>
            <video id="playing-video" class="vedio_centerization" autoplay playsinline>
              <source id="video-source" src="" type="video/mp4">
            </video>
          </div>
      
          <div class="video-container mobile-swiper">
            
            <span class="close" onclick="closeVideo()">&times;</span>
            <span class="prev" onclick="prevVideo()">❮</span>
            <span class="next" onclick="nextVideo()">❯</span>
            <span class="mute-toggle" onclick="toggleMute()">
