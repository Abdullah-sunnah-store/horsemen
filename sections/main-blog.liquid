<style>
.blog-sub-menu {
    display: flex;
    gap: 10px;
    justify-content: flex-start;
    margin-bottom: 20px;
    flex-wrap: wrap;
    padding: 10px;
}

.blog-sub-menu button {
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid #ccc;
    background: white;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s ease-in-out;
}

.blog-sub-menu button.active,
.blog-sub-menu button:hover {
    background: #E8E3DB;
    color: #121212;
    border: none;
    transform: scale(1.05);
}

.blog-articles__article {
    display: block; /* Ensures all articles are visible before filtering */
}
</style>

{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- paginate blog.articles by 6 -%}
  <div class="main-blog page-width">
    <h1 class="title--primary">
      {{ blog.title | escape }}
    </h1>

    <!-- Blog Filter Buttons -->
    <div class="blog-sub-menu">
      <button data-tag="all" class="active">All</button>
      {%- for tag in blog.all_tags -%}
        <button data-tag="{{ tag | handleize }}">{{ tag }}</button>
      {%- endfor -%}
    </div>

    <!-- Blog Articles -->
    <div class="blog-articles">
      {%- for article in blog.articles -%}
        <div
          class="blog-articles__article article"
          data-tags="{{ article.tags | join: ',' | handleize }}"
        >
          {%- render 'article-card',
            article: article,
            media_height: section.settings.image_height,
            media_aspect_ratio: article.image.aspect_ratio,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: true
          -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

<!-- JavaScript for Filtering -->
<script type="text/javascript">
document.addEventListener('DOMContentLoaded', () => {
  const buttons = document.querySelectorAll('.blog-sub-menu button');
  const articles = document.querySelectorAll('.blog-articles .blog-articles__article');

  console.log("✅ Buttons found:", buttons.length);
  console.log("✅ Articles found:", articles.length);

  buttons.forEach(button => {
    button.addEventListener('click', () => {
      console.log("▶ Clicked:", button.innerText);

      // Remove active class from all buttons
      document.querySelector('.blog-sub-menu button.active')?.classList.remove('active');
      button.classList.add('active');

      const selectedTag = button.getAttribute('data-tag');
      console.log("🔍 Filtering by:", selectedTag);

      articles.forEach(article => {
        const articleTags = article.getAttribute('data-tags')?.split(',') || [];
        console.log("📌 Article tags:", articleTags);

        if (selectedTag === 'all' || articleTags.includes(selectedTag)) {
          article.style.display = 'block';
        } else {
          article.style.display = 'none';
        }
      });
    });
  });
});
</script>


