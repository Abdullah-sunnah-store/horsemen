        },
        {
          "type": "breakdown_item",
          "settings": {
            "icon": "📄",
            "label": "Printing & materials",
            "amount": "£8.70"
          }
        },
        {
          "type": "breakdown_item",
          "settings": {
            "icon": "📦",
            "label": "Shipping (carbon-neutral)",
            "amount": "£2.50"
          }
        },
        {
          "type": "breakdown_item",
          "settings": {
            "icon": "💳",
